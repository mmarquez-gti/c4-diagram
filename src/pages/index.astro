---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="C4 Diagram Creator">
  <main class="flex flex-col items-center justify-center flex-1 gap-6 p-8">
    <h1 class="text-4xl font-bold text-blue-400">C4 Diagram Creator</h1>
    <p class="text-gray-400 max-w-md text-center">
      Create, edit, and visualise interactive C4 architecture diagrams. Navigate through system
      levels and export to Mermaid format.
    </p>
    <a
      href="/editor"
      class="px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-500 transition-colors font-semibold"
    >
      Open Editor
    </a>
  </main>
</AppLayout>
