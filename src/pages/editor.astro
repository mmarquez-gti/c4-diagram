---
import AppLayout from '../layouts/AppLayout.astro';
import DiagramCanvas from '../components/canvas/DiagramCanvas';
import DiagramsPanel from '../components/panels/DiagramsPanel';
import PropertiesPanel from '../components/panels/PropertiesPanel';
import EditorHeader from '../components/editor/EditorHeader';
import ShapePalette from '../components/editor/ShapePalette';
---

<AppLayout title="Editor — C4 Diagram Creator">
  <!-- Top menubar -->
  <EditorHeader client:load />

  <!-- Main workspace -->
  <div class="flex flex-1 overflow-hidden">
    <!-- Shape palette (hover to expand) -->
    <ShapePalette client:load />

    <!-- Left panel: Diagrams tree (collapsible) -->
    <DiagramsPanel client:load />

    <!-- Canvas area -->
    <main class="flex-1 overflow-hidden relative">
      <DiagramCanvas client:load />
    </main>

    <!-- Right panel: Properties (collapsible) -->
    <PropertiesPanel client:load />
  </div>
</AppLayout>
