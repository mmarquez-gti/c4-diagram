---
import AppLayout from '../layouts/AppLayout.astro';
import DiagramCanvas from '../components/canvas/DiagramCanvas';
import DiagramsPanel from '../components/panels/DiagramsPanel';
import PropertiesPanel from '../components/panels/PropertiesPanel';
import Toolbar from '../components/panels/Toolbar';
---

<AppLayout title="Editor — C4 Diagram Creator">
  <!-- Toolbar (React island for interactive state) -->
  <Toolbar client:load />

  <!-- Main workspace -->
  <div class="flex flex-1 overflow-hidden">
    <!-- Left panel: Diagrams tree -->
    <DiagramsPanel client:load />

    <!-- Canvas area (React island) -->
    <main class="flex-1 overflow-hidden">
      <DiagramCanvas client:load />
    </main>

    <!-- Right panel: Properties (React island) -->
    <aside class="w-64 bg-gray-900 border-l border-gray-700 flex flex-col p-3 gap-2 shrink-0 overflow-y-auto">
      <PropertiesPanel client:load />
    </aside>
  </div>
</AppLayout>
